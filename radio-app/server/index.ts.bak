import express, { Request, Response, NextFunction } from "express";
import cors from "cors";
import Groq from "groq-sdk";
import { config } from "dotenv";

config();

const app = express();
const PORT = process.env.PORT || 3001;
const GROQ_API_KEY = process.env.GROQ_API_KEY;

app.use(cors({
  origin: process.env.NODE_ENV === "production" ? false : "http://localhost:5173",
}));
app.use(express.json({ limit: "10mb" }));

const RADIO_GARDEN_API = "https://radio.garden/api";

// --- Helpers ---

function validateId(id: string | undefined): string | null {
  if (!id || !/^[a-zA-Z0-9_-]+$/.test(id)) return null;
  return id;
}

// Rate limiter for /api/listen: max 5 concurrent streams per IP
const listenStreams = new Map<string, number>();

function rateLimitListen(req: Request, res: Response, next: NextFunction): void {
  const ip = req.ip ?? req.socket.remoteAddress ?? "unknown";
  const current = listenStreams.get(ip) ?? 0;
  if (current >= 5) {
    res.status(429).json({ error: "Too many concurrent streams" });
    return;
  }
  listenStreams.set(ip, current + 1);
  res.on("close", () => {
    const count = listenStreams.get(ip) ?? 0;
    listenStreams.set(ip, Math.max(0, count - 1));
  });
  next();
}

// --- Routes ---

// Proxy: search stations
app.get("/api/search", async (req, res) => {
  const q = req.query.q as string;
  if (!q) return res.json({ data: [] });
  try {
    const resp = await fetch(`${RADIO_GARDEN_API}/search?q=${encodeURIComponent(q)}`);
    if (!resp.ok) {
      return res.status(502).json({ error: "Upstream search failed" });
    }
    const data = await resp.json();
    res.json(data);
  } catch {
    res.status(500).json({ error: "Search failed" });
  }
});

// Proxy: get all places
app.get("/api/places", async (_req, res) => {
  try {
    const resp = await fetch(`${RADIO_GARDEN_API}/ara/content/places`);
    if (!resp.ok) {
      return res.status(502).json({ error: "Upstream places request failed" });
    }
    const data = await resp.json();
    res.json(data);
  } catch {
    res.status(500).json({ error: "Failed to fetch places" });
  }
});

// Proxy: get place details (stations in a city)
app.get("/api/place/:id", async (req, res) => {
  const id = validateId(req.params.id);
  if (!id) return res.status(400).json({ error: "Invalid place ID" });
  try {
    const resp = await fetch(`${RADIO_GARDEN_API}/ara/content/page/${id}`);
    if (!resp.ok) {
      return res.status(502).json({ error: "Upstream place request failed" });
    }
    const data = await resp.json();
    res.json(data);
  } catch {
    res.status(500).json({ error: "Failed to fetch place" });
  }
});

// Proxy: get channel details
app.get("/api/channel/:id", async (req, res) => {
  const id = validateId(req.params.id);
  if (!id) return res.status(400).json({ error: "Invalid channel ID" });
  try {
    const resp = await fetch(`${RADIO_GARDEN_API}/ara/content/channel/${id}`);
    if (!resp.ok) {
      return res.status(502).json({ error: "Upstream channel request failed" });
    }
    const data = await resp.json();
    res.json(data);
  } catch {
    res.status(500).json({ error: "Failed to fetch channel" });
  }
});

// Proxy: stream audio — follow redirects and pipe the MP3 stream
app.get("/api/listen/:id", rateLimitListen, async (req, res) => {
  const id = validateId(req.params.id);
  if (!id) return res.status(400).json({ error: "Invalid stream ID" });
  try {
    const streamUrl = `${RADIO_GARDEN_API}/ara/content/listen/${id}/channel.mp3`;
    const resp = await fetch(streamUrl, { redirect: "follow" });

    if (!resp.ok || !resp.body) {
      return res.status(502).json({ error: "Stream unavailable" });
    }

    res.set({
      "Content-Type": resp.headers.get("content-type") || "audio/mpeg",
      "Transfer-Encoding": "chunked",
      "Cache-Control": "no-cache",
    });

    const reader = resp.body.getReader();
    const pump = async () => {
      while (true) {
        const { done, value } = await reader.read();
        if (done) break;
        if (!res.writableEnded) {
          res.write(value);
        }
      }
      res.end();
    };

    req.on("close", () => {
      reader.cancel();
    });

    pump().catch(() => res.end());
  } catch {
    res.status(500).json({ error: "Stream failed" });
  }
});

// Groq client (created once at module level)
let groq: Groq | null = null;
if (GROQ_API_KEY && GROQ_API_KEY !== "your_groq_api_key_here") {
  groq = new Groq({ apiKey: GROQ_API_KEY });
}

// Translate audio using Groq Whisper API + LLM
app.post("/api/translate", async (req, res) => {
  const { audio, targetLang } = req.body;
  if (!audio) {
    return res.status(400).json({ error: "Missing audio data" });
  }
  if (!groq) {
    return res.status(500).json({ error: "GROQ_API_KEY not set in .env" });
  }

  try {
    const buffer = Buffer.from(audio, "base64");
    const file = new File([buffer], "audio.wav", { type: "audio/wav" });

    // If target is English, use Whisper's built-in translation
    if (!targetLang || targetLang === "English") {
      const translation = await groq.audio.translations.create({
        file,
        model: "whisper-large-v3",
        response_format: "json",
      });
      return res.json({ text: translation.text });
    }

    // For other languages, transcribe first then translate with LLM
    const transcription = await groq.audio.transcriptions.create({
      file,
      model: "whisper-large-v3",
      response_format: "json",
    });

    if (!transcription.text?.trim()) {
      return res.json({ text: "" });
    }

    const chatResponse = await groq.chat.completions.create({
      model: "llama-3.3-70b-versatile",
      messages: [
        {
          role: "system",
          content: `You are a translator. Translate the following text into ${targetLang}. Output ONLY the translation, nothing else. No explanations, no quotes, no prefixes.`,
        },
        {
          role: "user",
          content: transcription.text,
        },
      ],
      temperature: 0.3,
      max_tokens: 1024,
    });

    const translated = chatResponse.choices[0]?.message?.content?.trim() ?? "";
    res.json({ text: translated });
  } catch {
    res.status(500).json({ error: "Translation service error" });
  }
});

// 404 handler — no route matched
app.use((_req, res) => {
  res.status(404).json({ error: "Not found" });
});

// Global error middleware
app.use((err: Error, _req: Request, res: Response, _next: NextFunction) => {
  console.error("Unhandled error:", err);
  res.status(500).json({ error: "Internal server error" });
});

app.listen(PORT, () => {
  console.log(`Radio Garden proxy server running on http://localhost:${PORT}`);
});
